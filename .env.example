# Mode aplikasi: development (terbuka penuh) | production (tampilkan countdown sebelum LAUNCH_AT)
APP_ENV=development
LAUNCH_AT=2026-11-30T00:00:00+08:00

# Domain (ubah ke domain asli saat deploy di VPS, mis: harapanku.id)
DOMAIN=localhost
ORIGIN=http://localhost:3000

# MySQL 8.0
MYSQL_ROOT_PASSWORD=harapanku_root_secret
MYSQL_DATABASE=harapanku
MYSQL_USER=harapanku_app
MYSQL_PASSWORD=harapanku_app_secret
DATABASE_URL=mysql://harapanku_app:harapanku_app_secret@127.0.0.1:3306/harapanku

# Auth & App
SESSION_SECRET=ganti_dengan_random_string_minimal_32_karakter
CLINIC_WA_NUMBER=6285248282929
